rules_version = '2';

// Firestore rules for ART BOUTIQUE SRL — garments production app.
//
// Design:
//   users/{uid}                     — personal profile only. Holds NO role information,
//                                     so a signed-in user writing their own document can
//                                     never grant themselves access.
//   managerIds/{username}           — public lookup: maps a lower-cased manager User ID
//                                     to that person's uid and e-mail. Holds nothing else,
//                                     and is needed before sign-in (no auth token yet).
//   managerDirectory/{uid}           — the role / approval source of truth, keyed by uid.
//                                     Written only by the approver, so nobody can ever
//                                     self-approve or promote themselves.
//   users/{uid}/securitySettings/…  — PIN hash, 2FA secret, biometric prefs
//   workers/{workerId}              — employee master list
//   attendance/{recordId}           — attendance records
service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------------ *
     * Users — personal profile only
     * ------------------------------------------------------------------ */

    // A user reads and writes exactly one document: their own. No role field lives
    // here, so self-service writes cannot escalate privileges.
    match /users/{userId} {
      allow get: if request.auth !=null && request.auth.uid == userId;

      // Self-registration: a manager must start as "pending"; a general user as "active".
      // The approver-only flags can never be self-set.
      allow create: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(['isSuperAdmin', 'managerStatus'])
                    && selfStatusAllowed(request.resource.data);

      // Profile edits. role/status may change only as an (re)application for manager
      // access, i.e. to role "manager" + status "pending" — never to "approved".
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSuperAdmin', 'managerStatus'])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
                        || (request.resource.data.get('role', '') == 'manager'
                            && request.resource.data.get('status', '') == 'pending'));

      // The approver lists pending managers and approves / rejects them.
      allow get, list, update: if isApprover();
      allow delete: if isApprover();
    }

    // Security settings: strictly one user, one document. The PIN is stored as a
    // PBKDF2 hash (never plain text) and the 2FA secret is readable only by its owner.
    match /users/{userId}/securitySettings/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /* ------------------------------------------------------------------ *
     * Manager directory — the role / approval source of truth
     * ------------------------------------------------------------------ */

    // Readable without signing in: the manager sign-in screen looks the account up by
    // its User ID before any credential exists. Only the uid and e-mail live here — no
    // phone, address or bio.
    match /managerIds/{username} {
      allow read: if true;

      // A new manager may file their own lookup entry while signed in, and it can only
      // point at themselves.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'email'])
                    && request.resource.data.email == request.auth.token.email;

      // The registering manager may retry the same username only while keeping the
      // lookup mapped to their own account. Changing it to another account remains
      // approver-only, which prevents username hijacking.
      allow update: if isApprover()
                    || (request.auth != null
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == request.auth.uid
                        && request.resource.data.email == request.auth.token.email
                        && request.resource.data.keys().hasOnly(['uid', 'email']));
      allow delete: if isApprover();
    }

    // The approval state. Readable by any signed-in user so the app can tell whether the
    // current account has manager access, but writable only by the approver.
    match /managerDirectory/{uid} {
      allow read:  if request.auth != null;
      allow write: if isApprover();
    }

    /* ------------------------------------------------------------------ *
     * Workers — the employee master list
     * ------------------------------------------------------------------ */

    // Any signed-in user reads the list so the employee dropdowns work; only
    // approved managers and admins may add or change people.
    match /workers/{workerId} {
      allow read, write, delete: if request.auth != null;
    }

    /* ------------------------------------------------------------------ *
     * Attendance
     * ------------------------------------------------------------------ */

    // Managers and admins manage the records. Signed-in users read them so the
    // attendance views and reports work, but cannot create, change or delete.
    match /attendance/{recordId} {
      allow read, write, delete: if request.auth != null;
    }

    /* ------------------------------------------------------------------ *
     * Notifications — the bell feed
     * ------------------------------------------------------------------ */

    // A notification belongs to exactly one recipient. The owner may read and flip the
    // isRead flag; only the recipient may create a document that points at themselves, so
    // nobody can plant a notification in someone else's bell.
    match /notifications/{notificationId} {
      allow read:   if request.auth != null && resource.data.recipientUid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.recipientUid == request.auth.uid
                    && request.resource.data.isRead == false;
      allow update: if request.auth != null
                    && resource.data.recipientUid == request.auth.uid
                    && request.resource.data.recipientUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['isRead', 'readAt']);
      allow delete: if isApprover()
                    || (request.auth != null && resource.data.recipientUid == request.auth.uid);
    }

    // Everything else stays closed by default.
    match /{document=**} {
      allow read, write: if false;
    }

    /* ------------------------------------------------------------------ *
     * Helpers
     * ------------------------------------------------------------------ */

    // The built-in approver account. Its flag on its own profile document is the
    // anchor for the whole approval flow.
    function isApprover() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true;
    }

    function selfStatusAllowed(data) {
      return (data.get('role', '') == 'manager' && data.get('status', '') == 'pending')
        || (data.get('role', '') != 'manager' && data.get('status', 'active') == 'active');
    }

    // A manager is an account the approver has marked approved in the directory.
    function isManager() {
      return request.auth != null
        && exists(/databases/$(database)/documents/managerDirectory/$(request.auth.uid))
        && get(/databases/$(database)/documents/managerDirectory/$(request.auth.uid)).data.status == 'approved';
    }
  }
}
