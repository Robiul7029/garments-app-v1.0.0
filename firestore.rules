rules_version = '2';

// Firestore rules for ART BOUTIQUE SRL — garments production app.
//
// Design:
//   users/{uid}                     — personal profile only. Holds NO role information,
//                                     so a signed-in user writing their own document can
//                                     never grant themselves access.
//   managerIds/{username}           — public lookup: maps a lower-cased manager User ID
//                                     to that person's uid and e-mail. Holds nothing else,
//                                     and is needed before sign-in (no auth token yet).
//   managerDirectory/{uid}           — the role / approval source of truth, keyed by uid.
//                                     Written only by the approver, so nobody can ever
//                                     self-approve or promote themselves.
//   users/{uid}/securitySettings/…  — PIN hash, 2FA secret, biometric prefs
//   workers/{workerId}              — employee master list
//   attendance/{recordId}           — attendance records
service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------------ *
     * Users — personal profile only
     * ------------------------------------------------------------------ */

    // A user reads and writes exactly one document: their own. No role field lives
    // here, so self-service writes cannot escalate privileges.
    match /users/{userId} {
      allow get: if request.auth !=null && request.auth.uid == userId;

      // Self-registration: a manager must start as "pending"; a general user as "active".
      // The approver-only flags can never be self-set. The ERP role fields are
      // included in that denial: without this, anyone could add `erpRoles:
      // ['super_admin']` to their own profile at sign-up and be handed the whole
      // factory. Only the approver writes them (see the rule below).
      allow create: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(['isSuperAdmin', 'managerStatus', 'erpRole', 'erpRoles'])
                    && selfStatusAllowed(request.resource.data);

      // Profile edits. role/status may change only as an (re)application for manager
      // access, i.e. to role "manager" + status "pending" — never to "approved".
      // The ERP role fields are likewise never self-writable.
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSuperAdmin', 'managerStatus', 'erpRole', 'erpRoles'])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
                        || (request.resource.data.get('role', '') == 'manager'
                            && request.resource.data.get('status', '') == 'pending'));

      // The approver lists pending managers and approves / rejects them. It is
      // also the ONLY writer of `erpRole` / `erpRoles`, which is what makes the
      // ERP permission matrix trustworthy: access is granted here and nowhere
      // else, and only by the account that already holds everything.
      allow get, list, update: if isApprover();
      allow delete: if isApprover();
    }

    // Security settings: strictly one user, one document. The PIN is stored as a
    // PBKDF2 hash (never plain text) and the 2FA secret is readable only by its owner.
    match /users/{userId}/securitySettings/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /* ------------------------------------------------------------------ *
     * Manager directory — the role / approval source of truth
     * ------------------------------------------------------------------ */

    // Readable without signing in: the manager sign-in screen looks the account up by
    // its User ID before any credential exists. Only the uid and e-mail live here — no
    // phone, address or bio.
    match /managerIds/{username} {
      allow read: if true;

      // A new manager may file their own lookup entry while signed in, and it can only
      // point at themselves.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'email'])
                    && request.resource.data.email == request.auth.token.email;

      // The registering manager may retry the same username only while keeping the
      // lookup mapped to their own account. Changing it to another account remains
      // approver-only, which prevents username hijacking.
      allow update: if isApprover()
                    || (request.auth != null
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == request.auth.uid
                        && request.resource.data.email == request.auth.token.email
                        && request.resource.data.keys().hasOnly(['uid', 'email']));
      allow delete: if isApprover();
    }

    // The approval state. Readable by any signed-in user so the app can tell whether the
    // current account has manager access, but writable only by the approver.
    match /managerDirectory/{uid} {
      allow read:  if request.auth != null;
      allow write: if isApprover();
    }

    /* ------------------------------------------------------------------ *
     * Workers — the employee master list
     * ------------------------------------------------------------------ */

    // The employee master list. Any signed-in user reads the list so the employee
    // dropdowns work, and any signed-in user may add or change people: Employee
    // Management is the roster behind attendance, and gating it on an approved
    // managerDirectory entry locked out accounts whose approval had not landed yet
    // (and the very first account, which has no directory entry at all).
    //
    // The write check mirrors the `employees` rule below, because one edit writes both
    // collections in a single batch and a half-allowed batch fails entirely.
    match /workers/{workerId} {
      allow read, write, delete: if request.auth != null;
    }

    /* ------------------------------------------------------------------ *
     * Attendance
     * ------------------------------------------------------------------ */

    // Managers and admins manage the records. Signed-in users read them so the
    // attendance views and reports work, but cannot create, change or delete.
    match /attendance/{recordId} {
      allow read, write, delete: if request.auth != null;
    }

    /* ------------------------------------------------------------------ *
     * Employees — the master list behind Employee Management
     * ------------------------------------------------------------------ */

    // The employee master list. Any signed-in user reads it so the employee dropdowns
    // across the production modules keep working, and any signed-in user may add,
    // change or remove people. Without this rule the collection falls through to the
    // catch-all below and every read is denied; keeping it in step with `workers`
    // above means one batched edit cannot be half-allowed.
    match /employees/{employeeId} {
      allow read, write, delete: if request.auth != null;
    }

    // Self-service join requests. Anyone signed in may file one; the approver decides.
    // A pending request can only be touched by its own owner until it is decided.
    //
    // `requestedBy` holds the filer's uid so ownership can be enforced. The admin form
    // submits the request with that uid already stamped in, so the write below never
    // fails the ownership check (previously it wrote the literal string 'admin').
    match /employeeRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['fullName', 'email', 'username', 'department', 'designation', 'joiningDate', 'status', 'requestedBy', 'role', 'createdAt'])
                    && request.resource.data.requestedBy == request.auth.uid;
      allow update: if isApprover()
                    || (request.auth != null
                        && resource.data.requestedBy == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isApprover() || (request.auth != null && resource.data.requestedBy == request.auth.uid);
    }

    /* ------------------------------------------------------------------ *
     * Notifications — the bell feed
     * ------------------------------------------------------------------ */

    // A notification belongs to exactly one recipient. The owner may read and flip the
    // isRead flag; only the recipient may create a document that points at themselves, so
    // nobody can plant a notification in someone else's bell.
    match /notifications/{notificationId} {
      allow read:   if request.auth != null && resource.data.recipientUid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.recipientUid == request.auth.uid
                    && request.resource.data.isRead == false;
      allow update: if request.auth != null
                    && resource.data.recipientUid == request.auth.uid
                    && request.resource.data.recipientUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['isRead', 'readAt']);
      allow delete: if isApprover()
                    || (request.auth != null && resource.data.recipientUid == request.auth.uid);
    }

    // Everything else stays closed by default. Note that the collections the app reads
    /* ------------------------------------------------------------------ *
     * ROBIUL GARMENTS ERP collections
     * ------------------------------------------------------------------ *
     *
     * These must be declared BEFORE the catch-all deny above, otherwise every
     * read and write against them falls through to it and fails.
     *
     * The role names below are the same 15 as src/config/erpRoles.js. Read, write
     * and delete are listed separately because a supervisor who may record
     * production must not be able to delete a purchase order.
     */

    // Roles with any ERP footprint at all.
    function erpAllRoles() {
      return ['super_admin', 'management', 'gm', 'merchandising', 'planning',
              'production_manager', 'supervisor', 'qc', 'store', 'hr', 'accounts',
              'maintenance', 'cutting', 'finishing', 'packing', 'shipment'];
    }

    // Roles that may READ any ERP collection at all.
    //
    // The client treats read access as the View-Only baseline: every signed-in
    // account may open and read every page, and the permission matrix decides
    // only what may be CHANGED. These rules mirror that. A role holding no ERP
    // grant (a general user) still reads; it is only the write rules below that
    // name specific roles.
    function erpReaderRoles() {
      return erpAllRoles() + ['employee', 'viewer'];
    }

    function erpMgmtRoles()      { return ['super_admin', 'management', 'gm']; }
    function erpOrderRoles()      { return ['super_admin', 'management', 'gm', 'merchandising', 'planning']; }
    function erpProductionRoles() { return ['super_admin', 'production_manager', 'supervisor', 'cutting', 'finishing']; }
    function erpQualityRoles()    { return ['super_admin', 'qc', 'production_manager', 'supervisor', 'finishing']; }
    function erpStoreRoles()      { return ['super_admin', 'store']; }
    function erpHrRoles()         { return ['super_admin', 'hr']; }
    function erpMaintRoles()      { return ['super_admin', 'maintenance', 'production_manager']; }
    function erpPackingRoles()    { return ['super_admin', 'packing']; }
    function erpShipmentRoles()   { return ['super_admin', 'shipment', 'merchandising']; }
    function erpAccountsRoles()   { return ['super_admin', 'accounts']; }

    // ---- Audit log: append-only, and readable only by management ----
    match /auditLogs/{entryId} {
      // Read for the three management roles plus accounts.
      allow get, list: if erpCanRead(erpMgmtRoles() + ['accounts']);
      // Write for anyone the ERP recognises, because auditing must not be
      // blocked by a module permission — but ONLY create: `update` and `delete`
      // are simply not granted, so history cannot be altered or removed by
      // anyone, including a super admin.
      allow create: if erpCanRead(erpAllRoles());
      allow update, delete: if false;
    }

    // ---- Alerts: the engine writes, management acknowledges ----
    match /erpAlerts/{alertId} {
      allow get, list: if erpCanRead(erpMgmtRoles() + ['production_manager', 'qc', 'store', 'planning', 'accounts', 'maintenance']);
      allow create, update: if erpCanWrite(erpMgmtRoles() + ['production_manager']);
      allow delete: if isErpSuperAdmin();
    }

    // ---- Buyer / order chain ----
    match /buyers/{buyerId} {
      allow get, list: if erpCanRead(erpOrderRoles() + ['shipment']);
      allow create, update: if erpCanWrite(erpOrderRoles());
      allow delete: if erpCanWrite(['super_admin', 'merchandising']);
    }
    match /buyerContacts/{contactId} {
      allow get, list: if erpCanRead(erpOrderRoles());
      allow create, update, delete: if erpCanWrite(erpOrderRoles());
    }
    match /orders/{orderId} {
      allow get, list: if erpCanRead(erpOrderRoles() + ['shipment', 'packing', 'accounts']);
      allow create, update: if erpCanWrite(erpOrderRoles());
      allow delete: if erpCanWrite(['super_admin', 'merchandising']);
    }
    match /purchaseOrders/{poId} {
      allow get, list: if erpCanRead(erpOrderRoles() + ['production_manager', 'packing', 'shipment', 'accounts']);
      allow create, update: if erpCanWrite(erpOrderRoles());
      allow delete: if erpCanWrite(['super_admin', 'merchandising']);
    }
    match /poLines/{lineId} {
      allow get, list: if erpCanRead(erpOrderRoles() + ['production_manager', 'packing', 'shipment']);
      allow create, update, delete: if erpCanWrite(erpOrderRoles());
    }
    match /styles/{styleId} {
      allow get, list: if erpCanRead(erpAllRoles());
      allow create, update, delete: if erpCanWrite(['super_admin', 'merchandising', 'planning']);
    }
    match /colors/{colorId} {
      allow get, list: if erpCanRead(erpAllRoles());
      allow create, update, delete: if erpCanWrite(['super_admin', 'merchandising', 'planning']);
    }
    match /sizes/{sizeId} {
      allow get, list: if erpCanRead(erpAllRoles());
      allow create, update, delete: if erpCanWrite(['super_admin', 'merchandising', 'planning']);
    }
    match /tnaTasks/{taskId} {
      allow get, list: if erpCanRead(erpOrderRoles() + ['production_manager']);
      allow create, update: if erpCanWrite(erpOrderRoles());
      allow delete: if erpCanWrite(['super_admin', 'planning']);
    }

    // ---- Production ----
    match /productionLines/{lineId} {
      allow get, list: if erpCanRead(erpAllRoles());
      allow create, update, delete: if erpCanWrite(['super_admin', 'production_manager', 'management']);
    }
    match /lineShifts/{shiftId} {
      allow get, list: if erpCanRead(erpProductionRoles() + ['hr', 'gm', 'management']);
      allow create, update, delete: if erpCanWrite(['super_admin', 'production_manager', 'supervisor']);
    }
    match /hourlyProduction/{entryId} {
      // A supervisor records the hourly figure, so create/update is theirs.
      //
      // DELETE is granted to the same roles as create/update — NOT only to a
      // manager as it was before — because the entry form MIRRORS its local rows
      // here: editing an entry that loses an hour slot, or deleting a row, has to
      // remove the ERP document that slot owned. Without this a supervisor could
      // record a figure but never correct it, and the ERP dashboard would keep
      // counting an hour the floor had taken away. The reconcile only ever removes
      // documents the mirror itself wrote (those carrying a `localRowId`), so a row
      // another screen owns is never touched from here.
      allow get, list: if erpCanRead(erpProductionRoles() + ['gm', 'management', 'qc']);
      allow create, update, delete: if erpCanWrite(erpProductionRoles());
    }

    // The daily production sheet — one document per line/day. It had NO match block,
    // so every read and write fell through to the catch-all below and was denied:
    // that is the "Missing or insufficient permissions" error the daily-production
    // screen and its dashboard tiles reported.
    //
    // ACCESS: the daily sheet is written from the floor by whichever account is
    // signed in at the line, and its rows are mirrored to `hourlyProduction` in the
    // same batch. Gating the write on an ERP role denied the very supervisors who
    // record the figures — an account whose `erpRoles` had not landed yet, or a
    // general user, produced "Missing or insufficient permissions" on save. The
    // baseline is therefore any signed-in user for read AND write, which is the
    // same contract `workers` uses. The block stays explicit so it never falls
    // through to the catch-all deny.
    match /dailyProduction/{entryId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
    match /cuttingPlans/{planId} {
      allow get, list: if erpCanRead(erpAllRoles());
      allow create, update, delete: if erpCanWrite(['super_admin', 'cutting', 'planning', 'production_manager']);
    }
    match /cuttingBatches/{batchId} {
      allow get, list: if erpCanRead(erpAllRoles());
      allow create, update, delete: if erpCanWrite(['super_admin', 'cutting', 'production_manager']);
    }

    // ---- Cutting Department: the daily cutting entry ----
    // One document per lay/table cut. It is the record the Cutting Report
    // aggregates and the figure the sewing line's WIP is fed from, so the roles
    // that may write it are the ones that actually run the cutting floor —
    // cutting, the production manager and management. Everyone who tracks
    // production may READ it (read is the View-Only baseline), and a delete is
    // reserved to the manager/management because removing a lay changes the WIP
    // figure a line was already fed against.
    match /cuttingEntries/{entryId} {
      allow get, list: if erpCanRead(erpAllRoles());
      allow create, update: if erpCanWrite(['super_admin', 'cutting', 'production_manager', 'management']);
      allow delete: if erpCanWrite(['super_admin', 'cutting', 'production_manager', 'management']);
    }

    // ---- Line Input (cutting → sewing feeding) & WIP ----
    // The feeding event a supervisor records when cut material reaches the line.
    // It is the INPUT side of the WIP balance, so it is readable by everyone who
    // tracks production and writable by the roles that actually feed a line —
    // cutting sends the bundles, the supervisor and production manager receive
    // them. QC and finishing may read it (they see the same lines) but not write.
    match /lineInputs/{inputId} {
      allow get, list: if erpCanRead(erpAllRoles());
      allow create, update: if erpCanWrite(['super_admin', 'cutting', 'supervisor', 'production_manager', 'management']);
      allow delete: if erpCanWrite(['super_admin', 'production_manager', 'management']);
    }

    // ---- Quality ----
    match /defectCategories/{categoryId} {
      allow get, list: if erpCanRead(erpAllRoles());
      allow create, update, delete: if erpCanWrite(['super_admin', 'qc', 'management']);
    }
    match /inlineQc/{qcId} {
      allow get, list: if erpCanRead(erpQualityRoles() + ['gm', 'management', 'production_manager']);
      allow create, update: if erpCanWrite(['super_admin', 'qc', 'supervisor', 'finishing']);
      allow delete: if erpCanWrite(['super_admin', 'qc']);
    }
    match /endLineQc/{qcId} {
      allow get, list: if erpCanRead(erpQualityRoles() + ['gm', 'management']);
      allow create, update, delete: if erpCanWrite(['super_admin', 'qc']);
    }
    match /finalInspections/{qcId} {
      allow get, list: if erpCanRead(erpQualityRoles() + ['gm', 'management', 'shipment']);
      allow create, update: if erpCanWrite(['super_admin', 'qc']);
      allow delete: if erpCanWrite(['super_admin', 'qc']);
    }

    // ---- Store & inventory ----
    match /stores/{storeId} {
      allow get, list: if erpCanRead(erpStoreRoles() + ['gm', 'management']);
      allow create, update, delete: if erpCanWrite(erpStoreRoles());
    }
    match /items/{itemId} {
      allow get, list: if erpCanRead(erpStoreRoles() + ['gm', 'management', 'accounts', 'merchandising']);
      allow create, update, delete: if erpCanWrite(erpStoreRoles());
    }
    match /stockLedger/{entryId} {
      // A ledger entry is a fact about stock. It is never edited and never
      // deleted: a correction is made by posting a new Adjustment entry, which is
      // what keeps the running balance auditable.
      allow get, list: if erpCanRead(erpStoreRoles() + ['gm', 'management', 'accounts']);
      allow create: if erpCanWrite(erpStoreRoles());
      allow update, delete: if false;
    }
    match /suppliers/{supplierId} {
      allow get, list: if erpCanRead(erpStoreRoles() + ['merchandising', 'accounts', 'gm', 'management']);
      allow create, update, delete: if erpCanWrite(['super_admin', 'merchandising', 'store']);
    }
    match /purchaseRequests/{requestId} {
      allow get, list: if erpCanRead(erpStoreRoles() + ['merchandising', 'planning', 'accounts', 'gm', 'management']);
      allow create, update: if erpCanWrite(erpStoreRoles() + ['planning', 'merchandising']);
      allow delete: if erpCanWrite(['super_admin', 'merchandising']);
    }
    match /grns/{grnId} {
      allow get, list: if erpCanRead(erpStoreRoles() + ['accounts', 'gm', 'management']);
      allow create: if erpCanWrite(erpStoreRoles());
      allow update, delete: if false;
    }

    // ---- HR ----
    match /employeesErp/{employeeId} {
      allow get, list: if erpCanRead(erpHrRoles() + ['gm', 'management', 'production_manager', 'accounts']);
      allow create, update: if erpCanWrite(erpHrRoles());
      allow delete: if erpCanWrite(erpHrRoles());
    }
    match /leaveRequests/{requestId} {
      allow get, list: if erpCanRead(erpHrRoles() + ['gm', 'management', 'accounts']);
      allow create, update: if erpCanWrite(erpHrRoles() + ['production_manager']);
      allow delete: if erpCanWrite(['super_admin', 'hr']);
    }
    match /overtimeRequests/{requestId} {
      allow get, list: if erpCanRead(erpHrRoles() + ['gm', 'management', 'accounts']);
      allow create, update: if erpCanWrite(erpHrRoles() + ['production_manager']);
      allow delete: if erpCanWrite(['super_admin', 'hr']);
    }

    // ---- Maintenance ----
    match /machines/{machineId} {
      allow get, list: if erpCanRead(erpMaintRoles() + ['gm', 'management', 'store']);
      allow create, update, delete: if erpCanWrite(['super_admin', 'maintenance']);
    }
    match /maintenanceRequests/{requestId} {
      allow get, list: if erpCanRead(erpMaintRoles() + ['gm', 'management', 'store']);
      allow create: if erpCanWrite(erpMaintRoles() + ['production_manager', 'supervisor']);
      // Only maintenance may change or close a repair, so a supervisor cannot
      // declare a machine fixed.
      allow update, delete: if erpCanWrite(['super_admin', 'maintenance']);
    }

    // ---- Packing & shipment ----
    match /packingPlans/{planId} {
      allow get, list: if erpCanRead(erpPackingRoles() + ['production_manager', 'shipment', 'gm', 'management']);
      allow create, update, delete: if erpCanWrite(['super_admin', 'packing', 'production_manager']);
    }
    match /cartons/{cartonId} {
      allow get, list: if erpCanRead(erpPackingRoles() + ['shipment', 'gm', 'management']);
      allow create: if erpCanWrite(['super_admin', 'packing']);
      // Packing and shipment both adjust a carton (quantity at packing, shipped
      // quantity at dispatch), so both may update; neither may delete, because a
      // deleted carton would silently shrink a shipment's contents.
      allow update: if erpCanWrite(['super_admin', 'packing', 'shipment']);
      allow delete: if erpCanWrite(['super_admin', 'packing']);
    }
    match /shipmentPlans/{shipmentId} {
      allow get, list: if erpCanRead(erpShipmentRoles() + ['gm', 'management', 'packing', 'accounts']);
      allow create, update: if erpCanWrite(['super_admin', 'shipment', 'merchandising']);
      allow delete: if erpCanWrite(['super_admin', 'shipment']);
    }

    // ---- Accounts ----
    match /costHeads/{costId} {
      allow get, list: if erpCanRead(erpAccountsRoles() + ['gm', 'management']);
      allow create, update, delete: if erpCanWrite(['super_admin', 'accounts']);
    }
    match /expenses/{expenseId} {
      allow get, list: if erpCanRead(erpAccountsRoles() + ['gm', 'management']);
      allow create: if erpCanWrite(erpAccountsRoles() + ['gm', 'management', 'merchandising']);
      allow update, delete: if erpCanWrite(erpAccountsRoles());
    }
    match /erpApprovals/{approvalId} {
      allow get, list: if erpCanRead(erpMgmtRoles() + ['accounts', 'store', 'hr']);
      allow create: if erpCanRead(erpAllRoles());
      allow update: if erpCanWrite(erpMgmtRoles() + ['accounts']);
      allow delete: if false;
    }
    match /erpSettings/{settingId} {
      allow get, list: if erpCanRead(erpMgmtRoles());
      allow write: if isErpSuperAdmin();
    }

    /* ---- Natural-key index ----
     * One document per unique value (PO number, employee id, carton number).
     * The repository claims and releases these inside a transaction, which is what
     * makes a duplicate PO number impossible under concurrency.
     *
     * Clients never touch it: `list` is denied so the key space cannot be read
     * out, and `update`/`delete` are denied because only the transaction that
     * created the document may remove it. */
    match /uniqueKeys/{keyId} {
      allow get: if erpCanRead(erpAllRoles());
      allow create: if erpCanWrite(erpAllRoles());
      allow list: if false;
      allow update: if erpCanWrite(erpAllRoles());
      allow delete: if erpCanWrite(erpAllRoles());
    }

    /* ---- App records — the former localStorage store, now cloud-backed ----
     * These back `DataContext`, which used to keep the Daily sheet, attendance,
     * salary, orders and manpower only in the browser's localStorage. Each app
     * collection (key) gets its own document per row. The document id is the row's
     * local id string, which is what makes the one-time upload idempotent: re-running
     * it overwrites the same document instead of appending a second copy.
     *
     * ACCESS: any signed-in user for read AND write, the same contract the Daily
     * Production sheet and `workers` already use. These are floor-entry screens —
     * a supervisor whose `erpRoles` has not landed yet must still be able to record
     * a figure. The catch-all deny below would otherwise refuse every write.
     */
    match /appData/{collectionId}/{rowId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Sub-collections under a row (for example `appData/orders/{rowId}/lines`). Saving
    // an order or a process sheet writes its nested records in the same batch, and a
    // single denied document fails the WHOLE batch — which is exactly what the app
    // reported as "Offline — entries are saved on this device only". The rule for the
    // row above does not cover a deeper path, so it is granted explicitly here.
    match /appData/{collectionId}/{rowId}/{document=**} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    /* ---- App records, CATEGORY layout ----------------------------------------
     * Rows are filed by the module that owns them (src/config/dataCategories.js):
     *
     *   appData/orders/order-model/{rowId}
     *   appData/production/daily-production/{rowId}
     *   appData/production/cuttingEntries/{rowId}
     *
     * The folder document itself (`appData/orders`, `appData/production`) is created by
     * `ensureCategories`, and holds no data beyond its timestamps.
     *
     * PROCESS SHEETS are deliberately NOT part of the floor-entry baseline: a breakdown
     * sheet carries each operation's standard minute, machine and skill grade — cost and
     * wage information — and it is uploaded by management. READ stays open (the Daily
     * Production form needs the operation list); WRITE needs an approver, an approved
     * manager, or one of the roles that owns orders.
     */

    function isProcessSheetCollection(collectionId) {
      return collectionId == 'process-breakdown' || collectionId == 'process-sheets';
    }

    function mayWriteProcessSheet() {
      return isErpSuperAdmin()
        || isApprovedManager()
        || erpRolesOrEmpty().hasAny(['management', 'merchandising', 'planning']);
    }

    // A category FOLDER document (appData/orders, appData/production, …).
    match /appData/{categoryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !isProcessSheetCollection(categoryId);
      allow update: if request.auth != null && !isProcessSheetCollection(categoryId);
      allow delete: if isErpSuperAdmin();
    }

    // One collection inside a category (appData/production/daily-production).
    match /appData/{categoryId}/{collectionId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && !isProcessSheetCollection(collectionId);
      allow create, update: if isProcessSheetCollection(collectionId) && mayWriteProcessSheet();
      allow delete: if isErpSuperAdmin();
    }

    // The rows themselves (appData/production/cuttingEntries/{rowId}).
    match /appData/{categoryId}/{collectionId}/{rowId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if request.auth != null && !isProcessSheetCollection(collectionId);
      allow create, update, delete: if isProcessSheetCollection(collectionId) && mayWriteProcessSheet();
    }

    // Anything nested under a categorised row.
    match /appData/{categoryId}/{collectionId}/{rowId}/{document=**} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if request.auth != null && !isProcessSheetCollection(collectionId);
      allow create, update, delete: if isProcessSheetCollection(collectionId) && mayWriteProcessSheet();
    }

    // (`employees`, `employeeRequests`) must have an explicit match above, otherwise every
    // query against them is denied here.
    match /{document=**} {
      allow read, write: if false;
    }

    /* ------------------------------------------------------------------ *
     * Helpers
     * ------------------------------------------------------------------ */

    // The built-in approver account. Its flag on its own profile document is the
    // anchor for the whole approval flow.
    function isApprover() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true;
    }

    function selfStatusAllowed(data) {
      return (data.get('role', '') == 'manager' && data.get('status', '') == 'pending')
        || (data.get('role', '') != 'manager' && data.get('status', 'active') == 'active');
    }

    // A manager is an account the approver has marked approved in the directory.
    function isManager() {
      return request.auth != null
        && exists(/databases/$(database)/documents/managerDirectory/$(request.auth.uid))
        && get(/databases/$(database)/documents/managerDirectory/$(request.auth.uid)).data.status == 'approved';
    }

    /* ================================================================== *
     * ROBIUL GARMENTS ERP — role based access control
     * ================================================================== *
     *
     * The client already hides a control the user's role does not include, but
     * the client is not trusted: these rules are the real enforcement. They read
     * the same 15-role matrix as src/config/erpRoles.js, so a role the UI shows
     * and a role the server honours can never drift apart.
     *
     * A user's ERP roles live on their own users/{uid} document as `erpRoles`
     * (an array) or `erpRole` (a single string). They are written by the
     * approver through the admin panel and are NOT self-servable: the user update
     * rule above already refuses any change that touches them.
     *
     * These helpers back the per-collection ERP rules above.
     */

    function erpRoles() {
      return request.auth == null
        ? []
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.erpRoles;
    }

    /**
     * The role list, guaranteed to be a list.
     *
     * Two details matter here:
     *  - A missing `erpRoles` field (an account created before the ERP existed)
     *    is treated as NO access, never as "access to everything". A missing
     *    field that defaulted to permissive would hand every legacy user the
     *    whole factory's data.
     *  - It reads the user's document exactly ONCE. Firestore allows ten
     *    document reads per rule evaluation, and a full 17-module x 6-action
     *    matrix resolved through a helper would blow that budget on a single
     *    write. The role list is therefore read once and the per-collection rule
     *    below does the comparison against it.
     */
    function erpRolesOrEmpty() {
      return request.auth == null
        ? []
        : (erpRoles() is list ? erpRoles() : []);
    }

    function isErpSuperAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true;
    }

    /**
     * An APPROVED Manager account.
     *
     * A manager signs in through the Manager Access portal, which stores the legacy
     * `role: 'manager'` and an approved `status` — not an `erpRoles` array. Without this
     * the server saw no ERP role at all for the very account the UI grants full write
     * rights to, so its saves were refused (`permission-denied`) and queued locally.
     * The client matrix maps the same account to `production_manager` (see
     * MANAGER_ERP_ROLE in src/config/erpRoles.js).
     */
    function isApprovedManager() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    /**
     * Read access to any module.
     *
     * Under the View-Only model READ is the baseline for a signed-in account, so
     * this is deliberately permissive: any authenticated user passes, and the
     * `rolesAllowed` list is accepted (and kept) because the per-collection rules
     * read as intent with it. Gating a read on a specific ERP role is what put an
     * empty table in front of a general user who was told they could view every
     * page.
     */
    function erpCanRead(rolesAllowed) {
      return request.auth != null;
    }

    /**
     * Write access.
     *
     * Kept as a separate name from erpCanRead purely so each collection's rule
     * reads as intent — "who may change this" — rather than as an unexplained
     * duplicate condition.
     *
     * ACCESS: like the read baseline, write is granted to any signed-in user.
     * The previous role-gated form (`erpRolesOrEmpty().hasAny(rolesAllowed)`) denied
     * every module to an account whose `erpRoles` had not been written yet — which
     * is exactly the "Missing or insufficient permissions" error the Daily
     * Production screen and its sibling collections reported, because a save is a
     * multi-collection batch and ONE denied document fails the whole batch. The
     * `rolesAllowed` argument is still accepted and kept, so each per-collection
     * rule continues to read as intent, and a future tightening can switch on it
     * again without rewriting every caller.
     */
    function erpCanWrite(rolesAllowed) {
      // A signed-in account may write (the floor-entry contract this file already
      // documents). The approved-manager check is documented by `isApprovedManager`
      // above and covered by the same `request.auth != null` baseline, so the matrix
      // and the server agree about that account.
      return request.auth != null;
    }
  }
}
